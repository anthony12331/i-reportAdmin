<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 2: Account &amp; Verification"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <EditText android:id="@+id/reg_username" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Username"/>
        <EditText android:id="@+id/reg_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email" android:inputType="textEmailAddress"/>
        <EditText android:id="@+id/reg_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Password" android:inputType="textPassword"/>
        <EditText android:id="@+id/reg_confirm_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Confirm Password" android:inputType="textPassword"/>

        <ImageView
            android:id="@+id/iv_selfie_preview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:src="@android:drawable/ic_menu_camera"
            android:background="#EEEEEE" />

        <Button android:id="@+id/btn_selfie" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Take Selfie Photo" android:layout_marginTop="5dp"/>

        <ImageView
            android:id="@+id/iv_id_preview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="15dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="#EEEEEE" />

        <Button android:id="@+id/btn_id_picture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Take ID Picture" android:layout_marginTop="5dp"/>

        <Button
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTER"
            android:layout_marginTop="30dp"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>
</ScrollView>