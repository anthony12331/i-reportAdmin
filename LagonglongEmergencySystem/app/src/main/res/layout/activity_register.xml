<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="30dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CREATE ACCOUNT"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1 of 2: Personal Details"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="30dp"/>

        <EditText
            android:id="@+id/reg_first_name"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:hint="First Name"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="2dp"
            android:textColor="#333333"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/reg_middle_name"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:hint="Middle Name"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="2dp"
            android:textColor="#333333"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/reg_last_name"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:hint="Last Name"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="2dp"
            android:textColor="#333333"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/reg_extension"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:hint="extension (optional)"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="2dp"
            android:textColor="#333333"
            android:layout_marginBottom="15dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp">

            <EditText
                android:id="@+id/reg_age"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Age"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:elevation="2dp"
                android:textColor="#333333"
                android:inputType="number"
                android:layout_marginEnd="10dp"/>

            <EditText
                android:id="@+id/reg_contact"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="2"
                android:background="#FFFFFF"
                android:hint="Mobile Number"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:elevation="2dp"
                android:textColor="#333333"
                android:inputType="phone"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Municipality"
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="10dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:layout_marginBottom="15dp">

            <Spinner
                android:id="@+id/spinner_municipality"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Barangay"
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginBottom="5dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:layout_marginBottom="25dp">

            <Spinner
                android:id="@+id/spinner_barangay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </RelativeLayout>

        <Button
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="NEXT STEP"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"/>

    </LinearLayout>
</ScrollView>