<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.IncidentReports" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="android:statusBarColor">@color/dashboard_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/dashboard_bg</item>
    </style>

    <style name="Theme.IncidentReports" parent="Base.Theme.IncidentReports" />

    <style name="Theme.IncidentReports.Login" parent="Theme.IncidentReports">
        <item name="android:statusBarColor">@color/login_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>