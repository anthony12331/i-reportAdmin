<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1C2431"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:id="@+id/layoutNotificationContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <View
            android:id="@+id/imgNotificationIconBg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_rect"
            android:backgroundTint="#11161E" />

        <ImageView
            android:id="@+id/imgNotificationIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="false"
            android:layout_alignStart="@id/imgNotificationIconBg"
            android:layout_alignTop="@id/imgNotificationIconBg"
            android:layout_alignEnd="@id/imgNotificationIconBg"
            android:layout_alignBottom="@id/imgNotificationIconBg"
            android:padding="4dp"
            android:src="@drawable/alert"
            app:tint="@color/accent_blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/imgNotificationIconBg"
            android:layout_toStartOf="@id/layoutTimeDot"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNotificationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Incident Assigned"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNotificationMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Structure Fire - Engine 42, Truck 10. Location: 742 Evergreen Terrace...."
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTimeDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtNotificationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Just Now"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <View
                android:id="@+id/dotUnread"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="@color/accent_blue" />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
